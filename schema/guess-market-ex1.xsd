<?xml version="1.0" encoding="UTF-8"?>
<!--
  RECONSTRUCTION of the exercise 1 schema, drawn from the diagram in appendix D
  of the exercise document.

  Use the official .xsd from Mama if one was published there. This file exists so
  that xjc can be run and sample files validated before that download happens; if
  the official schema differs, regenerate and adjust the mapper accordingly.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="Guess-Market">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="GM-events"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GM-events">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="GM-event" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GM-event">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id" type="xs:int"/>
        <xs:element name="description" type="xs:string"/>
        <xs:element ref="comision"/>
        <xs:element ref="GM-options"/>
        <xs:element ref="GM-method"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="comision">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:int">
          <xs:attribute name="type" type="xs:string" use="required"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="GM-options">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="GM-option" type="xs:string" minOccurs="1" maxOccurs="2"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GM-method">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="GM-LMSR"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="GM-LMSR">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="b" type="xs:int"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
